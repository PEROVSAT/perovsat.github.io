---
import Layout from '../layouts/Layout.astro';
import TextBlock from '../components/TextBlock.astro';
import SatScrolly from '../components/SatScrolly.astro';
import MissionTimeline from '../components/MissionTimeline.astro';
import HomeCta from '../components/HomeCta.astro';
import { withBase } from '../utils/url';
---

<Layout title="Home" starfield contentWidth="wide">
  <div class="home">
    <section class="hero">
      <img
        class="hero__logo"
        src={withBase('PerovskiteLogoV2DarkBG.png')}
        alt=""
        width="160"
        height="160"
      />
      <div class="hero__text">
        <p class="hero__eyebrow">Rhodes College · 1U CubeSat</p>
        <h1>PEROVSAT</h1>
        <p class="hero__lead">
          Testing the space-readiness of experimental Perovskite solar cells
          against traditional silicon, across two illumination periods
        </p>
      </div>
    </section>

    <div class="glance">
      <TextBlock title="At a glance" eyebrow="Mission">
        <p>
          A student-built CubeSat comparing experimental Perovskite solar cells
          to space-grade silicon, under two lighting and thermal regimes in orbit.
        </p>
        <dl class="glance__facts">
          <div class="glance__fact">
            <dt>Form factor</dt>
            <dd>1U CubeSat</dd>
          </div>
          <div class="glance__fact">
            <dt>Built at</dt>
            <dd>Rhodes College</dd>
          </div>
          <div class="glance__fact">
            <dt>Payload</dt>
            <dd>Perovskite + silicon PV</dd>
          </div>
          <div class="glance__fact">
            <dt>Experiment</dt>
            <dd>Dual-face Perovskite illumination</dd>
          </div>
          <div class="glance__fact">
            <dt>Bus</dt>
            <dd>Nearspace Launch</dd>
          </div>
          <div class="glance__fact">
            <dt>Cells</dt>
            <dd>National Lab of the Rockies</dd>
          </div>
        </dl>
      </TextBlock>
    </div>

    <SatScrolly>
      <TextBlock slot="rhodes" variant="caption" title="Built at Rhodes" eyebrow="Team">
        <p>PEROVSAT is a 1U CubeSat made by students of Rhodes College, enables STEM students fantastic real-world engineering experince.</p>
        <p>Multiple graduates of RHOK-SAT, PEROVSAT's predecessor, have landed aerospace jobs due to their experience with the program.</p>
      </TextBlock>

      <TextBlock slot="perovskites" variant="caption" title="Perovskites" eyebrow="Science">
        <p>PEROVSAT's namesake is its payload: experimental Perovskite solar cells. These present potential for high efficiency solar energy at low manufacturing costs</p>
      </TextBlock>

      <TextBlock slot="source" variant="caption" title="The Experiment" eyebrow="Science">
        <p>PEROVSAT aims to evaluate the feasiblity of Perovskite use in space missions. The dual payload face design allows us to test efficiency degradation across vastly different thermal conditions</p>
      </TextBlock>
    </SatScrolly>

    <MissionTimeline />

    <HomeCta />
  </div>
</Layout>

<style>
  .home {
    padding-top: 8rem;
    padding-bottom: 1rem;
  }

  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.75rem;
    align-items: center;
    max-width: 46rem;
    min-height: min(28vh, 16rem);
    margin: 0 auto 6rem;
  }

  .hero__logo {
    width: 152px;
    height: auto;
    display: block;
    mix-blend-mode: lighten;
  }

  .hero__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
    letter-spacing: 0.08em;
    color: var(--rhodes-text);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.75);
  }

  .hero__lead {
    margin: 0;
    color: var(--rhodes-text-muted);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.55;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.9);
  }

  .glance {
    margin: 0 0 4.5rem;
  }

  .glance :global(.tb) {
    padding: 1.7rem 2.15rem 1.85rem;
  }

  .glance :global(.tb__header) {
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
  }

  .glance :global(.tb__title) {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .glance :global(.tb__body p) {
    max-width: 44rem;
    margin-bottom: 1.35rem;
    color: var(--rhodes-text-muted);
  }

  .glance__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem 2rem;
    margin: 0;
  }

  .glance__fact dt {
    margin: 0 0 0.28rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  .glance__fact dd {
    margin: 0;
    color: var(--rhodes-text);
    font-size: 1.05rem;
    line-height: 1.4;
  }

  @media (max-width: 800px) {
    .home {
      padding-top: 4rem;
    }

    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      max-width: 34rem;
      min-height: 0;
      margin-bottom: 4.25rem;
    }

    .hero__logo {
      width: 140px;
    }

    .glance :global(.tb) {
      padding: 1.35rem 1.35rem 1.45rem;
    }

    .glance__facts {
      grid-template-columns: 1fr 1fr;
      gap: 1rem 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .glance__facts {
      grid-template-columns: 1fr;
    }
  }
</style>

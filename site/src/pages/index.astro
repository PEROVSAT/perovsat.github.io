---
import Layout from '../layouts/Layout.astro';
import TextBlock from '../components/TextBlock.astro';
import SatScrolly from '../components/SatScrolly.astro';
import MissionTimeline from '../components/MissionTimeline.astro';
import HomeCta from '../components/HomeCta.astro';
import { withBase } from '../utils/url';
---

<Layout title="Home" starfield contentWidth="wide">
  <div class="home">
    <section class="hero">
      <img
        class="hero__logo"
        src={withBase('PerovskiteLogoV2DarkBG.png')}
        alt=""
        width="160"
        height="160"
      />
      <div class="hero__text">
        <p class="hero__eyebrow">Rhodes College · 1U CubeSat</p>
        <h1>PEROVSAT</h1>
        <p class="hero__lead">
          Testing the space-readiness of experimental Perovskite solar cells
          against traditional silicon, across two illumination periods
        </p>
      </div>
    </section>

    <SatScrolly>
      <TextBlock slot="rhodes" variant="caption" title="Built at Rhodes" eyebrow="Team">
        <p>A 1U CubeSat designed by students and faculty at Rhodes College — liberal arts, with real flight hardware on the table.</p>
      </TextBlock>

      <TextBlock slot="perovskites" variant="caption" title="Why perovskites" eyebrow="Science">
        <p>An experimental solar-cell chemistry that can be cheaper to make, and potentially more efficient, than the silicon cells spacecraft already fly.</p>
      </TextBlock>

      <TextBlock slot="source" variant="caption" title="From the National Lab of the Rockies" eyebrow="Partners">
        <p>Our perovskite cells come from the National Lab of the Rockies (formerly NREL). PEROVSAT is how they leave the lab and see orbit.</p>
      </TextBlock>

      <TextBlock slot="experiment" variant="caption" title="Two ways to see the Sun" eyebrow="The experiment">
        <p>PEROVSAT lines up with Earth’s magnetic field so two faces get very different light: long, infrequent soaks on Z, and short, frequent bursts on the rotating −X face.</p>
      </TextBlock>

      <TextBlock slot="payoff" variant="caption" title="What we learn" eyebrow="Why it matters">
        <p>Those two thermal rhythms are the test. If perovskites hold up, they become a real option for future missions — not just a promising material on the ground.</p>
      </TextBlock>
    </SatScrolly>

    <MissionTimeline />

    <HomeCta />
  </div>
</Layout>

<style>
  .home {
    padding-top: 8rem;
    padding-bottom: 1rem;
  }

  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem 1.5rem;
    align-items: center;
    max-width: 36rem;
    margin: 0 0 1.5rem;
  }

  .hero__logo {
    width: 132px;
    height: auto;
    display: block;
    mix-blend-mode: lighten;
  }

  .hero__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  h1 {
    margin: 0 0 0.65rem;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    letter-spacing: 0.08em;
    color: var(--rhodes-text);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.75);
  }

  .hero__lead {
    margin: 0;
    color: var(--rhodes-text-muted);
    font-size: 1.08rem;
    line-height: 1.55;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.9);
  }

  @media (max-width: 800px) {
    .home {
      padding-top: 3rem;
    }

    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      max-width: 34rem;
      margin-inline: auto;
    }
  }
</style>

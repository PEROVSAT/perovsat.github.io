---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
const headingId = `tb-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<section class="tb" aria-labelledby={headingId}>
  <header class="tb__header">
    {eyebrow && <p class="tb__eyebrow">{eyebrow}</p>}
    <h2 class="tb__title" id={headingId}>{title}</h2>
  </header>
  <div class="tb__body">
    <slot />
  </div>
</section>

<style>
  .tb {
    position: relative;
    padding: 1.15rem 1.6rem 1.2rem;
    color: var(--rhodes-text);
    background-color: rgba(10, 10, 12, 0.52);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-image:
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red));
    background-size:
      18px 2px, 2px 18px,
      18px 2px, 2px 18px,
      18px 2px, 2px 18px,
      18px 2px, 2px 18px;
    background-position:
      left top, left top,
      right top, right top,
      left bottom, left bottom,
      right bottom, right bottom;
    background-repeat: no-repeat;
  }

  .tb__header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tb__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  .tb__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rhodes-text);
  }

  .tb__body {
    color: var(--rhodes-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .tb__body :global(p),
  .tb__body :global(ol) {
    margin: 0;
  }

  .tb__body :global(p + p) {
    margin-top: 0.9rem;
  }
</style>

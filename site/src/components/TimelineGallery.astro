---
interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="wheel" data-wheel>
    <div class="wheel__frame" data-wheel-open>
      {images.map((image, i) => (
        <img
          class:list={['wheel__img', i === 0 && 'is-active']}
          src={image.src}
          alt={image.alt}
          width="960"
          height="600"
          data-wheel-img
        />
      ))}
      <span class="wheel__zoom" aria-hidden="true">Enlarge</span>
    </div>
    {images.length > 1 && (
      <div class="wheel__controls">
        <button type="button" class="wheel__nav" data-wheel-prev aria-label="Previous photo">
          ‹
        </button>
        <div class="wheel__dots" role="tablist" aria-label="Photos">
          {images.map((_, i) => (
            <button
              type="button"
              class:list={['wheel__dot', i === 0 && 'is-active']}
              data-wheel-dot
              aria-label={`Photo ${i + 1}`}
            />
          ))}
        </div>
        <button type="button" class="wheel__nav" data-wheel-next aria-label="Next photo">
          ›
        </button>
      </div>
    )}
  </div>
)}

<style>
  .wheel {
    margin-top: 1rem;
  }

  .wheel__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: zoom-in;
  }

  .wheel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .wheel__img.is-active {
    opacity: 1;
  }

  .wheel__zoom {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    z-index: 1;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(10, 10, 12, 0.78);
    color: var(--rhodes-text-muted);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .wheel__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.65rem;
  }

  .wheel__nav {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 10, 12, 0.6);
    color: var(--rhodes-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .wheel__nav:hover {
    border-color: var(--rhodes-red);
    color: var(--rhodes-red);
  }

  .wheel__dots {
    display: flex;
    gap: 0.4rem;
  }

  .wheel__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
  }

  .wheel__dot.is-active {
    background: var(--rhodes-red);
  }
</style>

---
import { withBase } from '../utils/url';

const FRAME_COUNT = 60;
const IMAGE_SIZE = 1080;
/** Visible square on each 1080 frame. Crops empty space under the satellite. */
const CROP_SIZE = 940;
const CROP_X = (IMAGE_SIZE - CROP_SIZE) / 2;
const CROP_Y = 0;
const frameBase = withBase('assets/PEROVSAT_Render/');
const firstFrame = `${frameBase}0001.webp`;

interface Point {
  x: number;
  y: number;
}

interface Part {
  id: string;
  title: string;
  group: string;
  body: string;
  /** Pixel targets on the last frame, origin at the top-left of the 1080×1080 image. */
  targets: Point[];
}

const PARTS: Part[] = [
  {
    id: 'perovskites',
    title: 'Perovskites',
    group: 'Payload',
    body: 'Experimental solar cells. Two large tandem cells and two smaller 1-inch cells on each face',
    targets: [
      { x: 600, y: 75 },
      { x: 700, y: 230 },
    ],
  },
  {
    id: 'reference-cells',
    title: 'Reference cells',
    group: 'Payload',
    body: 'Standard space-grade silicon solar cells, used as the experiment control',
    targets: [{ x: 420, y: 140 }],
  },
  {
    id: 'power-cells',
    title: 'Power cells',
    group: 'Bus',
    body: 'Body-mounted solar array to keep PEROVSAT operational',
    targets: [{ x: 800, y: 600 }],
  },
  {
    id: 'antenna',
    title: 'Antenna',
    group: 'Bus',
    body: 'Downlinks scientific data via the Iridium network',
    targets: [{ x: 534, y: 900 }],
  },
];

function markerStyle(pt: Point) {
  const left = ((pt.x - CROP_X) / CROP_SIZE) * 100;
  const top = ((pt.y - CROP_Y) / CROP_SIZE) * 100;
  return `left: ${left}%; top: ${top}%;`;
}
---

<section
  class="scrolly"
  data-sat-scrolly
  data-frame-base={frameBase}
  data-frame-count={FRAME_COUNT}
  data-crop-x={CROP_X}
  data-crop-y={CROP_Y}
  data-crop-size={CROP_SIZE}
  style={`--image-size: ${IMAGE_SIZE}; --crop-size: ${CROP_SIZE}; --crop-x: ${CROP_X}; --crop-y: ${CROP_Y};`}
>
  <div class="scrolly__visual">
    <div class="scrolly__pin">
      <div class="scrolly__stage">
        <img
          class="scrolly__fallback"
          src={firstFrame}
          alt="PEROVSAT CubeSat"
          width={IMAGE_SIZE}
          height={IMAGE_SIZE}
          decoding="async"
        />
        <canvas class="scrolly__canvas" width={IMAGE_SIZE} height={IMAGE_SIZE} aria-hidden="true"></canvas>
      </div>
      <div class="scrolly__markers" aria-hidden="true">
        {PARTS.flatMap((part, n) =>
          part.targets.map((pt) => (
            <span class="scrolly__marker" style={markerStyle(pt)} data-part={part.id}>{n + 1}</span>
          ))
        )}
      </div>
    </div>
  </div>

  <div class="scrolly__copy">
    <div class="scrolly__chapter">
      <slot name="rhodes" />
    </div>
    <div class="scrolly__chapter">
      <slot name="perovskites" />
    </div>
    <div class="scrolly__chapter">
      <slot name="source" />
    </div>
    <div class="scrolly__chapter">
      <slot name="experiment" />
    </div>
    <div class="scrolly__chapter">
      <slot name="payoff" />
    </div>

    <ol class="scrolly__parts">
      {PARTS.map((part, n) => (
        <li class="scrolly__chapter scrolly__chapter--part" data-part={part.id}>
          <div class="callout">
            <span class="callout__n" aria-hidden="true">{n + 1}</span>
            <div class="callout__body">
              <p class="callout__group">{part.group}</p>
              <h3 class="callout__title">{part.title}</h3>
              <p class="callout__copy">{part.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .scrolly {
    --stage-h: min(58vh, 640px);
    position: relative;
    display: grid;
    grid-template-columns: var(--stage-h) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    align-items: start;
  }

  .scrolly__visual {
    min-height: 100%;
  }

  .scrolly__copy {
    position: relative;
    z-index: 2;
  }

  .scrolly__pin {
    position: sticky;
    top: 5.5rem;
    height: var(--stage-h);
    width: var(--stage-h);
    max-width: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .scrolly__stage {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .scrolly__fallback,
  .scrolly__canvas {
    position: absolute;
    display: block;
    mix-blend-mode: lighten;
  }

  .scrolly__fallback {
    top: calc(var(--crop-y) / var(--crop-size) * -100%);
    left: calc(var(--crop-x) / var(--crop-size) * -100%);
    width: calc(var(--image-size) / var(--crop-size) * 100%);
    height: calc(var(--image-size) / var(--crop-size) * 100%);
  }

  .scrolly__canvas {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scrolly__canvas {
    opacity: 0;
  }

  .scrolly.is-ready .scrolly__fallback {
    visibility: hidden;
  }

  .scrolly.is-ready .scrolly__canvas {
    opacity: 1;
  }

  .scrolly__markers {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .scrolly.is-callouts .scrolly__markers {
    opacity: 1;
  }

  .scrolly__marker {
    position: absolute;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    transform: translate(-50%, -50%) scale(0.88);
    border-radius: 50%;
    background: var(--rhodes-red);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0 0 3px rgba(196, 2, 43, 0.28);
    opacity: 0.4;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .scrolly__marker.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.08);
  }

  .scrolly__chapter {
    display: flex;
    align-items: center;
    min-height: 78vh;
    padding: 8vh 0;
  }

  .scrolly__chapter :global(.tb) {
    width: 100%;
    max-width: 34rem;
  }

  .scrolly__parts {
    margin: 0;
    padding: 0 0 12vh;
    list-style: none;
  }

  .scrolly__chapter--part {
    max-width: 34rem;
  }

  .callout {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: 1rem 1.15rem 1.1rem;
    background: rgba(10, 10, 12, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .callout__n {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--rhodes-red);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .callout__group {
    margin: 0 0 0.2rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  .callout__title {
    margin: 0 0 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--rhodes-text);
  }

  .callout__copy {
    margin: 0;
    color: var(--rhodes-text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .scrolly {
      --stage-h: min(44vh, 360px);
      grid-template-columns: 1fr;
    }

    .scrolly__visual,
    .scrolly__copy {
      grid-column: 1;
      grid-row: 1;
    }

    .scrolly__copy {
      padding-top: var(--stage-h);
    }

    .scrolly__pin {
      margin-inline: auto;
    }

    .scrolly__chapter {
      justify-content: center;
      align-items: flex-end;
      min-height: 72vh;
    }

    .scrolly__chapter :global(.tb),
    .scrolly__chapter--part {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scrolly__pin {
      position: relative;
      top: auto;
    }

    .scrolly__chapter {
      min-height: 0;
      padding: 1.75rem 0;
    }

    .scrolly__parts {
      padding-bottom: 2rem;
    }

    .scrolly__markers {
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sat-scrolly]');
  if (root) {
    const pin = root.querySelector<HTMLElement>('.scrolly__pin')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.scrolly__canvas')!;
    const ctx = canvas.getContext('2d', { alpha: true });
    const frameBase = root.dataset.frameBase ?? '';
    const frameCount = Number(root.dataset.frameCount ?? 60);
    const cropX = Number(root.dataset.cropX ?? 0);
    const cropY = Number(root.dataset.cropY ?? 0);
    const cropSize = Number(root.dataset.cropSize ?? 1080);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /** Unfold through the narrative beats; part callouts follow on the open satellite. */
    const UNFOLD_END = 0.54;
    const CALLOUT_START = 0.56;

    const frames: (HTMLImageElement | undefined)[] = new Array(frameCount);
    let drawn = -1;
    let target = 0;
    let ticking = false;

    function srcFor(index: number) {
      return `${frameBase}${String(index + 1).padStart(4, '0')}.webp`;
    }

    function loadFrame(index: number): Promise<HTMLImageElement> {
      const existing = frames[index];
      if (existing && existing.complete && existing.naturalWidth > 0) {
        return Promise.resolve(existing);
      }
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
          frames[index] = img;
          if (index === target) {
            drawn = -1;
            draw(target);
          }
          resolve(img);
        };
        img.onerror = () => reject(new Error(`Failed to load ${srcFor(index)}`));
        img.src = srcFor(index);
      });
    }

    function nearestLoaded(index: number): HTMLImageElement | undefined {
      if (frames[index]) return frames[index];
      for (let d = 1; d < frameCount; d++) {
        if (index - d >= 0 && frames[index - d]) return frames[index - d];
        if (index + d < frameCount && frames[index + d]) return frames[index + d];
      }
      return undefined;
    }

    function draw(index: number) {
      if (!ctx) return;
      target = index;
      const img = nearestLoaded(index);
      if (!img) return;
      if (index === drawn && frames[index]) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, cropX, cropY, cropSize, cropSize, 0, 0, canvas.width, canvas.height);
      drawn = frames[index] ? index : -1;
    }

    function pinProgress(): number {
      const stickyTop = Number.parseFloat(getComputedStyle(pin).top) || 0;
      const rootRect = root.getBoundingClientRect();
      const startTop = stickyTop;
      const endTop = stickyTop + pin.offsetHeight - root.offsetHeight;
      const span = startTop - endTop;
      if (span <= 0) return 0;
      return Math.min(1, Math.max(0, (startTop - rootRect.top) / span));
    }

    function frameForProgress(progress: number) {
      if (progress <= 0) return 0;
      if (progress >= UNFOLD_END) return frameCount - 1;
      return Math.round((progress / UNFOLD_END) * (frameCount - 1));
    }

    const partChapters = Array.from(root.querySelectorAll<HTMLElement>('.scrolly__chapter[data-part]'));
    const markers = Array.from(root.querySelectorAll<HTMLElement>('.scrolly__marker'));

    function setActivePart(id: string | null) {
      markers.forEach((marker) => {
        marker.classList.toggle('is-active', Boolean(id) && marker.dataset.part === id);
      });
    }

    function activePartId(): string | null {
      const mid = window.innerHeight * 0.58;
      let current: string | null = null;
      for (const chapter of partChapters) {
        const rect = chapter.getBoundingClientRect();
        if (rect.top <= mid) current = chapter.dataset.part ?? null;
      }
      return current;
    }

    function update() {
      const progress = reduceMotion ? 1 : pinProgress();
      const index = reduceMotion ? frameCount - 1 : frameForProgress(progress);
      draw(index);
      const inCallouts = reduceMotion || progress >= CALLOUT_START;
      root.classList.toggle('is-callouts', inCallouts);
      setActivePart(inCallouts ? activePartId() : null);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }

    async function preloadRest() {
      const concurrency = 8;
      let next = 0;
      async function worker() {
        while (next < frameCount) {
          const i = next++;
          if (frames[i]) continue;
          try {
            await loadFrame(i);
          } catch {
            /* keep nearest-loaded fallback */
          }
        }
      }
      await Promise.all(Array.from({ length: concurrency }, () => worker()));
    }

    const startIndex = reduceMotion ? frameCount - 1 : 0;
    loadFrame(startIndex)
      .then(() => {
        draw(startIndex);
        root.classList.add('is-ready');
        update();
      })
      .catch(() => {
        /* fallback <img> stays visible */
      });

    if (!reduceMotion) void preloadRest();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>

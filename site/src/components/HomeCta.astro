---
import { withBase } from '../utils/url';
---

<nav class="home-cta" aria-label="Related pages">
  <a href={withBase('team')}>Team</a>
  <span class="home-cta__dot" aria-hidden="true">·</span>
  <a href={withBase('partners')}>Partners</a>
  <span class="home-cta__dot" aria-hidden="true">·</span>
  <a href={withBase('documentation/')} target="_blank" rel="noopener noreferrer">Documentation</a>
</nav>

<style>
  .home-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem 0.7rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--rhodes-text-muted);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .home-cta a {
    color: var(--rhodes-text-muted);
  }

  .home-cta a:hover {
    color: var(--rhodes-red);
  }

  .home-cta__dot {
    opacity: 0.4;
  }
</style>

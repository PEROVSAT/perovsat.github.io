---
import { withBase } from '../utils/url';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={withBase()}>
      <img src={withBase('PerovskiteIsometricV2.png')} alt="PEROVSAT Logo" width="50" height="50" />
      <span>PEROVSAT</span>
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      <a href={withBase()}>Home</a>
      <a href={withBase('team')}>Team</a>
      <a href={withBase('partners')}>Partners</a>
      <a href={withBase('documentation/')} class="nav-external" target="_blank" rel="noopener noreferrer">
        Documentation
        <svg class="nav-external__icon" width="12" height="12" viewBox="0 0 12 12" aria-label="Opens in documentation site" role="img">
          <path d="M2 10 L10 2 M5.5 2 H10 V6.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="1" y="5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rhodes-border);
    background: var(--rhodes-surface);
    position: relative;
    z-index: 100;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(1100px, 100%);
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .site-header__brand img {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.9rem;
  }

  .site-header__nav > a {
    color: var(--rhodes-text-muted);
    white-space: nowrap;
  }

  .site-header__nav > a:hover {
    color: var(--rhodes-red);
  }

  .nav-external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-external__icon {
    opacity: 0.7;
    flex-shrink: 0;
  }
</style>

---
import { withBase } from '../utils/url';

type Status = 'complete' | 'current' | 'upcoming';

interface Stage {
  id: string;
  title: string;
  dates: string;
  status: Status;
  description: string;
  images?: { src: string; alt: string }[];
  href?: string;
}

const STAGES: Stage[] = [
  {
    id: 'mission-design',
    title: 'Mission Design',
    dates: 'Summer 2026',
    status: 'current',
    description:
      'Requirements, payload architecture, and the two-illumination experiment are being locked in before engineering-model hardware is built. ',
    images: [
      { src: withBase('assets/timeline_photos/payloadDesign.png'), alt: 'PDR - payload design' },
      { src: withBase('assets/timeline_photos/missionGoal.png'), alt: 'PDR - Mission Goal' },
      { src: withBase('assets/timeline_photos/FSWoverview.png'), alt: 'PDR - Flight Software Design' },
      { src: withBase('MissionPatchV1.png'), alt: 'PEROVSAT mission patch' },
      { src: withBase('assets/PEROVSAT_Render/0001.webp'), alt: 'PEROVSAT CubeSat render' },
    ],
  },
  {
    id: 'em-integration',
    title: 'EM System Integration',
    dates: 'Fall 2026 – Spring 2027',
    status: 'upcoming',
    description:
      'Assemble the engineering model, bring up the flight computer and payload electronics, and verify the experiment faces against the bus.',
  },
  {
    id: 'fm-integration',
    title: 'FM System Integration',
    dates: 'Summer 2027',
    status: 'upcoming',
    description:
      'Build and integrate the flight-model spacecraft, replacing engineering-model hardware with flight-qualified parts.',
  },
  {
    id: 'testing',
    title: 'Testing and Iterating',
    dates: 'Fall 2027 – Spring 2028',
    status: 'upcoming',
    description:
      'Environmental testing, anomaly resolution, and design updates as we shake out the flight article.',
  },
  {
    id: 'frr',
    title: 'Flight-Readiness Review',
    dates: 'Summer 2028',
    status: 'upcoming',
    description:
      'Formal review that PEROVSAT is ready to ship for launch integration.',
  },
  {
    id: 'launch',
    title: 'Launch',
    dates: 'Fall 2029',
    status: 'upcoming',
    description:
      'Rideshare to orbit and the start of on-orbit operations.',
  },
];

const STATUS_LABEL: Record<Status, string> = {
  complete: 'Complete',
  current: 'In progress',
  upcoming: 'Upcoming',
};
---

<section class="tl" aria-labelledby="tl-title" data-mission-timeline>
  <header class="tl__header">
    <p class="tl__eyebrow">Mission</p>
    <h2 class="tl__title" id="tl-title">Timeline</h2>
  </header>

  <ol class="tl__stages">
    {STAGES.map((stage) => {
      const expanded = stage.status !== 'upcoming';
      return (
        <li class:list={['tl__stage', `tl__stage--${stage.status}`]} data-stage={stage.id}>
          <div class="tl__node" aria-hidden="true"></div>
          <div class="tl__card">
            <div class="tl__meta">
              <p class="tl__status">{STATUS_LABEL[stage.status]}</p>
              <p class="tl__dates">{stage.dates}</p>
            </div>
            <h3 class="tl__name">{stage.title}</h3>
            <p class="tl__copy">{stage.description}</p>

            {expanded && stage.images && stage.images.length > 0 && (
              <div class="wheel" data-wheel>
                <div class="wheel__frame" data-wheel-open>
                  {stage.images.map((image, i) => (
                    <img
                      class:list={['wheel__img', i === 0 && 'is-active']}
                      src={image.src}
                      alt={image.alt}
                      width="640"
                      height="400"
                      data-wheel-img
                    />
                  ))}
                </div>
                {stage.images.length > 1 && (
                  <div class="wheel__controls">
                    <button type="button" class="wheel__nav" data-wheel-prev aria-label="Previous photo">
                      ‹
                    </button>
                    <div class="wheel__dots" role="tablist" aria-label="Photos">
                      {stage.images.map((_, i) => (
                        <button
                          type="button"
                          class:list={['wheel__dot', i === 0 && 'is-active']}
                          data-wheel-dot
                          aria-label={`Photo ${i + 1}`}
                        />
                      ))}
                    </div>
                    <button type="button" class="wheel__nav" data-wheel-next aria-label="Next photo">
                      ›
                    </button>
                  </div>
                )}
              </div>
            )}

            {expanded && stage.href && (
              <a class="tl__link" href={stage.href}>
                Read the full update
              </a>
            )}
          </div>
        </li>
      );
    })}
  </ol>

  <dialog class="lightbox" data-lightbox aria-label="Enlarged timeline photo">
    <img class="lightbox__img" alt="" data-lightbox-img />
    <form method="dialog">
      <button class="lightbox__close" type="submit">Close</button>
    </form>
  </dialog>
</section>

<style>
  .tl {
    width: 100%;
  }

  .tl__header {
    margin: 0 0 1.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tl__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rhodes-red);
  }

  .tl__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rhodes-text);
  }

  .tl__stages {
    --rail: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tl__stage {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: 1.1rem;
    padding: 0 0 1.65rem;
  }

  .tl__stage:last-child {
    padding-bottom: 0;
  }

  .tl__stage::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) / 2);
    top: 0.55rem;
    bottom: -0.35rem;
    width: 1px;
    background: rgba(255, 255, 255, 0.12);
    transform: translateX(-50%);
  }

  .tl__stage:last-child::before {
    display: none;
  }

  .tl__node {
    position: relative;
    z-index: 1;
    width: var(--rail);
    height: var(--rail);
    margin-top: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.28);
    background: rgba(10, 10, 12, 0.9);
  }

  .tl__stage--complete .tl__node,
  .tl__stage--current .tl__node {
    border-color: var(--rhodes-red);
    background: var(--rhodes-red);
    box-shadow: 0 0 0 3px rgba(196, 2, 43, 0.22);
  }

  .tl__card {
    min-width: 0;
  }

  .tl__stage--complete .tl__card,
  .tl__stage--current .tl__card {
    padding: 1.1rem 1.35rem 1.2rem;
    background-color: rgba(10, 10, 12, 0.52);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-image:
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red)),
      linear-gradient(var(--rhodes-red), var(--rhodes-red));
    background-size:
      18px 2px, 2px 18px,
      18px 2px, 2px 18px,
      18px 2px, 2px 18px,
      18px 2px, 2px 18px;
    background-position:
      left top, left top,
      right top, right top,
      left bottom, left bottom,
      right bottom, right bottom;
    background-repeat: no-repeat;
  }

  .tl__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-bottom: 0.3rem;
  }

  .tl__status {
    margin: 0;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--rhodes-text-muted);
  }

  .tl__stage--current .tl__status,
  .tl__stage--complete .tl__status {
    color: var(--rhodes-red);
  }

  .tl__dates {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--rhodes-text-muted);
  }

  .tl__name {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--rhodes-text);
  }

  .tl__copy {
    margin: 0;
    color: var(--rhodes-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .tl__stage--upcoming .tl__name {
    font-size: 0.98rem;
    margin-bottom: 0.25rem;
  }

  .tl__stage--upcoming .tl__copy {
    font-size: 0.9rem;
  }

  .tl__link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    color: var(--rhodes-text);
    border-bottom: 1px solid rgba(196, 2, 43, 0.7);
  }

  .tl__link:hover {
    color: var(--rhodes-red);
  }

  .wheel {
    margin-top: 1rem;
  }

  .wheel__frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: zoom-in;
  }

  .wheel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .wheel__img.is-active {
    opacity: 1;
  }

  .wheel__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.65rem;
  }

  .wheel__nav {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 10, 12, 0.6);
    color: var(--rhodes-text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .wheel__nav:hover {
    border-color: var(--rhodes-red);
    color: var(--rhodes-red);
  }

  .wheel__dots {
    display: flex;
    gap: 0.4rem;
  }

  .wheel__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
  }

  .wheel__dot.is-active {
    background: var(--rhodes-red);
  }

  .lightbox {
    width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 0.75rem 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0a0a0c;
    color: var(--rhodes-text);
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.78);
  }

  .lightbox__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(92vh - 3.5rem);
    object-fit: contain;
    background: #000;
  }

  .lightbox__close {
    display: block;
    margin: 0.65rem 0 0 auto;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: var(--rhodes-text-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .lightbox__close:hover {
    color: var(--rhodes-red);
    border-color: var(--rhodes-red);
  }

</style>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  document.querySelectorAll<HTMLElement>('[data-wheel]').forEach((wheel) => {
    const images = Array.from(wheel.querySelectorAll<HTMLImageElement>('[data-wheel-img]'));
    const dots = Array.from(wheel.querySelectorAll<HTMLButtonElement>('[data-wheel-dot]'));
    const prev = wheel.querySelector<HTMLButtonElement>('[data-wheel-prev]');
    const next = wheel.querySelector<HTMLButtonElement>('[data-wheel-next]');
    const open = wheel.querySelector<HTMLElement>('[data-wheel-open]');
    if (images.length === 0) return;

    let index = 0;

    function show(nextIndex: number) {
      index = (nextIndex + images.length) % images.length;
      images.forEach((img, i) => img.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    }

    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    open?.addEventListener('click', () => {
      const current = images[index];
      if (!lightbox || !lightboxImg || !current) return;
      lightboxImg.src = current.src;
      lightboxImg.alt = current.alt;
      lightbox.showModal();
    });
  });
</script>

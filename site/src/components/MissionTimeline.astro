---
import { withBase } from '../utils/url';
import TimelinePost from './TimelinePost.astro';
import TimelineTrack from './TimelineTrack.astro';
import type { StageStatus } from './TimelineStage.astro';

interface TimelineImage {
  src: string;
  alt: string;
}

interface MissionEvent {
  id: string;
  title: string;
  when: string;
  whenShort?: string;
  location?: string;
  description?: string;
  images?: TimelineImage[];
  href?: string;
}

interface Stage {
  id: string;
  title: string;
  when: string;
  status: StageStatus;
  description?: string;
  images?: TimelineImage[];
  href?: string;
  events?: MissionEvent[];
}

const STAGES: Stage[] = [
  {
    id: 'mission-design',
    title: 'Mission Design',
    when: 'Apr – Aug 2026',
    status: 'complete',
    description: 'TODO',
    events: [
      {
        id: 'pdr',
        title: 'Preliminary Design Review',
        when: 'Jul 22, 2026',
        whenShort: 'Jul 22',
        images: [
          { src: withBase('assets/timeline_photos/payloadDesign.png'), alt: 'PDR — payload design' },
          { src: withBase('assets/timeline_photos/missionGoal.png'), alt: 'PDR — mission goal' },
          { src: withBase('assets/timeline_photos/FSWoverview.png'), alt: 'PDR — flight software design' },
        ],
      },
      {
        id: 'smallsat',
        title: 'SmallSat Conference',
        when: 'Aug 23, 2026',
        whenShort: 'Aug 23',
        location: 'Salt Lake City, UT',
        description: '',
        images: [
        ],
      },
    ],
  },
  {
    id: 'em-integration',
    title: 'EM System Integration',
    when: 'Sep 2026 – May 2027',
    status: 'current',
  },
  {
    id: 'fm-integration',
    title: 'FM System Integration',
    when: 'Jun – Aug 2027',
    status: 'upcoming',
  },
  {
    id: 'testing',
    title: 'Testing and Iterating',
    when: 'Sep 2027 – May 2028',
    status: 'upcoming',
  },
  {
    id: 'frr',
    title: 'Flight-Readiness Review',
    when: 'Jun – Aug 2028',
    status: 'upcoming',
  },
  {
    id: 'launch',
    title: 'Launch',
    when: 'Sep – Nov 2029',
    status: 'upcoming',
  },
];

const FUTURE_GREYS = ['#7d7d7d', '#6a6a6a', '#585858', '#474747', '#3a3a3a'];
const V_SPAN_BASE = 5.6;
const V_SPAN_EVENT = 4.75;

function compactSpan(eventCount: number) {
  if (eventCount === 0) return V_SPAN_BASE;
  return Math.max(V_SPAN_BASE, 2.8 + eventCount * V_SPAN_EVENT);
}

function slotAt(index: number, count: number) {
  if (count <= 1) return 0.5;
  return (index + 1) / (count + 1);
}

function arrowFill(stage: Stage, upcomingIndex: number) {
  if (stage.status === 'complete') return 'var(--rhodes-green)';
  if (stage.status === 'current') return 'var(--rhodes-red)';
  return FUTURE_GREYS[Math.min(upcomingIndex, FUTURE_GREYS.length - 1)];
}

let upcomingIndex = 0;
const view = STAGES.map((stage, i) => {
  const fill = arrowFill(stage, stage.status === 'upcoming' ? upcomingIndex++ : 0);
  const events = stage.events ?? [];
  return {
    ...stage,
    fill,
    span: `${compactSpan(events.length)}rem`,
    z: STAGES.length - i,
    events: events.map((event, index) => ({
      ...event,
      whenShort: event.whenShort ?? event.when,
      along: slotAt(index, events.length),
      index,
    })),
  };
});

const posts = view.flatMap((stage) => [
  {
    id: stage.id,
    kind: 'stage' as const,
    title: stage.title,
    when: stage.when,
    status: stage.status as StageStatus | undefined,
    location: undefined as string | undefined,
    description: stage.description,
    images: stage.images,
    href: stage.href,
    fill: stage.fill,
  },
  ...stage.events.map((event) => ({
    id: event.id,
    kind: 'event' as const,
    title: event.title,
    when: event.when,
    status: undefined as StageStatus | undefined,
    location: event.location,
    description: event.description,
    images: event.images,
    href: event.href,
    fill: stage.fill,
  })),
]);

const INITIAL_ID = STAGES.find((stage) => stage.status === 'current')?.id ?? STAGES[0].id;
---

<section class="tl" aria-labelledby="tl-title" data-mission-timeline data-initial={INITIAL_ID}>
  <header class="tl__header">
    <h2 class="tl__title" id="tl-title">Timeline</h2>
  </header>

  <div class="tl__h">
    <TimelineTrack orientation="horizontal" stages={view} activeId={INITIAL_ID} />
  </div>
  <div class="tl__v">
    <TimelineTrack orientation="vertical" stages={view} activeId={INITIAL_ID} />
  </div>

  <div class="tl__blog" data-blog aria-live="polite">
    {posts.map((post) => (
      <TimelinePost
        id={post.id}
        kind={post.kind}
        title={post.title}
        when={post.when}
        status={post.status}
        location={post.location}
        description={post.description}
        images={post.images}
        href={post.href}
        fill={post.fill}
        active={post.id === INITIAL_ID}
      />
    ))}
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Enlarged timeline photo">
    <img class="lightbox__img" alt="" data-lightbox-img />
    <form method="dialog">
      <button class="lightbox__close" type="submit">Close</button>
    </form>
  </dialog>
</section>

<style>
  .tl {
    --tip: 1.45rem;
    --gap: 5px;
    --arrow-w: 4.4rem;
    --arrow-h: 3.35rem;
    width: 100%;
    margin: 4.5rem 0 0;
    overflow: visible;
  }

  .tl__header {
    margin: 0 0 1.5rem;
  }

  .tl__title {
    margin: 0;
    font-size: clamp(1.9rem, 4.2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rhodes-text);
  }

  .tl__v {
    display: none;
  }

  .tl__blog {
    margin-top: 0.45rem;
  }

  .lightbox {
    width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 0.75rem 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0a0a0c;
    color: var(--rhodes-text);
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.78);
  }

  .lightbox__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(92vh - 3.5rem);
    object-fit: contain;
    background: #000;
  }

  .lightbox__close {
    display: block;
    margin: 0.65rem 0 0 auto;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: var(--rhodes-text-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .lightbox__close:hover {
    color: var(--rhodes-red);
    border-color: var(--rhodes-red);
  }

  @media (max-width: 800px) {
    .tl {
      --arrow-w: 3.15rem;
      --tip: 1.2rem;
      margin-top: 3rem;
    }

    .tl__h {
      display: none;
    }

    .tl__v {
      display: block;
    }

    .tl__blog {
      margin-top: 0.7rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mission-timeline]');
  if (root) {
    const posts = Array.from(root.querySelectorAll<HTMLElement>('[data-post]'));
    const triggers = Array.from(root.querySelectorAll<HTMLElement>('[data-open]'));
    const stages = Array.from(root.querySelectorAll<HTMLElement>('[data-stage]'));
    const ids = new Set(posts.map((post) => post.dataset.post));
    const initial = root.dataset.initial ?? posts[0]?.dataset.post;

    function select(id: string, scroll = false) {
      posts.forEach((post) => {
        const on = post.dataset.post === id;
        post.hidden = !on;
        post.classList.toggle('is-active', on);
        if (on && scroll) {
          post.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      triggers.forEach((trigger) => {
        const on = trigger.dataset.open === id;
        trigger.classList.toggle('is-active', on);
        trigger.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      stages.forEach((stage) => {
        const owned = Array.from(stage.querySelectorAll<HTMLElement>('[data-open]')).some(
          (trigger) => trigger.dataset.open === id,
        );
        stage.classList.toggle('is-lit', owned);
      });
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const id = trigger.dataset.open;
        if (!id) return;
        select(id, true);
      });
    });

    const hashId = decodeURIComponent(location.hash.replace(/^#/, ''));
    select(ids.has(hashId) ? hashId : initial ?? '', false);

    function intersects(a: DOMRect, b: DOMRect, gap: number) {
      return !(
        a.right + gap <= b.left ||
        a.left >= b.right + gap ||
        a.bottom + gap <= b.top ||
        a.top >= b.bottom + gap
      );
    }

    function applyBox(el: HTMLElement, x: number, y: number) {
      el.style.setProperty('--box-x', `${x}px`);
      el.style.setProperty('--box-y', `${y}px`);
      const len = Math.max(Math.hypot(x, y), 8);
      el.style.setProperty('--stem-len', `${len}px`);
      el.style.setProperty('--stem-angle', `${Math.atan2(-x, y)}rad`);
    }

    function layoutTrack(track: HTMLElement) {
      const vertical = track.dataset.track === 'vertical';
      track.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
        const events = Array.from(stage.querySelectorAll<HTMLElement>('[data-event]'));
        if (events.length === 0) return;

        const gap = 10;
        const baseX = vertical ? 18 : 0;
        const baseY = vertical ? 0 : 11;
        const stageRect = stage.getBoundingClientRect();
        const spine = stage.querySelector('.stage__spine');

        events.forEach((event) => {
          event.style.removeProperty('top');
          event.style.setProperty('--nudge', '0px');
          applyBox(event, baseX, baseY);
        });

        if (vertical && spine instanceof HTMLElement) {
          const rootSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
          const tipRaw = getComputedStyle(stage).getPropertyValue('--tip').trim();
          const tip = tipRaw.endsWith('rem')
            ? Number.parseFloat(tipRaw) * rootSize
            : Number.parseFloat(tipRaw) || 20;
          const stackGap = 14;

          let cursor = tip + 10;
          events.forEach((event) => {
            applyBox(event, baseX, 0);
            const box = event.querySelector('[data-event-box]');
            if (box instanceof HTMLElement) {
              const remain = stageRect.right - event.getBoundingClientRect().left - baseX - 4;
              box.style.maxWidth = `${Math.max(96, remain)}px`;
            }
            const height = box instanceof HTMLElement ? box.getBoundingClientRect().height : 48;
            cursor += height / 2;
            event.style.top = `${cursor}px`;
            applyBox(event, baseX, 0);
            cursor += height / 2 + stackGap;
          });

          const needed = Math.round(cursor + tip);
          const next = `${Math.max(needed, Math.round(tip * 2 + 48))}px`;
          if (spine.style.minHeight !== next) spine.style.minHeight = next;
          return;
        }

        events.forEach((event, i) => {
          let x = baseX;
          let y = baseY;
          let guard = 0;
          while (guard++ < 20) {
            applyBox(event, x, y);
            const box = event.querySelector('[data-event-box]');
            if (!(box instanceof HTMLElement)) break;
            const rect = box.getBoundingClientRect();
            const hit = events.slice(0, i).some((other) => {
              const otherBox = other.querySelector('[data-event-box]');
              return otherBox instanceof HTMLElement && intersects(rect, otherBox.getBoundingClientRect(), gap);
            });
            if (!hit) break;

            const overlapRight = events.slice(0, i).reduce((max, other) => {
              const otherBox = other.querySelector('[data-event-box]');
              if (!(otherBox instanceof HTMLElement)) return max;
              const otherRect = otherBox.getBoundingClientRect();
              if (!intersects(rect, otherRect, gap)) return max;
              return Math.max(max, otherRect.right + gap - rect.left);
            }, 0);
            const nextX = x + overlapRight;
            if (overlapRight > 1 && Math.abs(nextX) <= 72) {
              x = nextX;
            } else {
              x = baseX;
              y += rect.height + gap;
            }
          }
          applyBox(event, x, y);
        });

        if (spine instanceof HTMLElement) {
          const spineBottom = spine.getBoundingClientRect().bottom;
          let extra = 36;
          events.forEach((event) => {
            const box = event.querySelector('[data-event-box]');
            if (!(box instanceof HTMLElement)) return;
            extra = Math.max(extra, box.getBoundingClientRect().bottom - spineBottom + 10);
          });
          const next = `${Math.round(extra)}px`;
          if (stage.style.paddingBottom !== next) stage.style.paddingBottom = next;
        }
      });
    }

    function layoutVisible() {
      root.querySelectorAll<HTMLElement>('[data-track]').forEach((track) => {
        if (track.offsetWidth === 0 && track.offsetHeight === 0) return;
        layoutTrack(track);
      });
    }

    let frame = 0;
    function scheduleLayout() {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        layoutVisible();
      });
    }
    layoutVisible();
    document.fonts?.ready.then(scheduleLayout);
    window.addEventListener('resize', scheduleLayout);
    new ResizeObserver(scheduleLayout).observe(root);
  }

  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  document.querySelectorAll<HTMLElement>('[data-wheel]').forEach((wheel) => {
    const images = Array.from(wheel.querySelectorAll<HTMLImageElement>('[data-wheel-img]'));
    const dots = Array.from(wheel.querySelectorAll<HTMLButtonElement>('[data-wheel-dot]'));
    const prev = wheel.querySelector<HTMLButtonElement>('[data-wheel-prev]');
    const next = wheel.querySelector<HTMLButtonElement>('[data-wheel-next]');
    const open = wheel.querySelector<HTMLElement>('[data-wheel-open]');
    if (images.length === 0) return;

    let index = 0;

    function show(nextIndex: number) {
      index = (nextIndex + images.length) % images.length;
      images.forEach((img, i) => img.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    }

    prev?.addEventListener('click', (event) => {
      event.stopPropagation();
      show(index - 1);
    });
    next?.addEventListener('click', (event) => {
      event.stopPropagation();
      show(index + 1);
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', (event) => {
        event.stopPropagation();
        show(i);
      }),
    );

    open?.addEventListener('click', () => {
      const current = images[index];
      if (!lightbox || !lightboxImg || !current) return;
      lightboxImg.src = current.src;
      lightboxImg.alt = current.alt;
      lightbox.showModal();
    });
  });
</script>
